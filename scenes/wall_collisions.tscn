[node name="BackgroundVisual" type="Sprite2D" parent="." unique_id=1718016071]
editor_description = "地面视觉层。1536x1024 按 x1.25 均匀缩放铺满 1920x1280——和墙层一样是 3:2，所以没有形变。这张图必须只有地面：它的前一版本自己画着一整套墙和拱门，和墙层是两张互不相干的地图（相位相关峰均比 6.1，同源对照 614339），玩家于是同时看到两套墙，其中一套走得过去。换图时请守住这条：地面图里不能有任何会被读成墙的结构。"
z_index = -100
scale = Vector2(1.25, 1.25)
texture = ExtResource("1_floor")
centered = false

[node name="WallsVisual" type="Sprite2D" parent="." unique_id=1718016072]
editor_description = "墙体视觉层。这张图正是下方 Wall_* 碰撞多边形的来源，必须与它们同坐标系：1536x1024 按 x1.25 均匀缩放铺满 1920x1280 地图。不要改成地板图的非均匀比例(1.325967, 1.178637)，否则玩家看到的墙会和实际碰撞错位，产生空气墙和莫名其妙的视野遮挡。"
z_index = -50
scale = Vector2(1.25, 1.25)
texture = ExtResource("1_walls")
centered = false

