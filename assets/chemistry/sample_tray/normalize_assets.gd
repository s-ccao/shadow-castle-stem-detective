extends SceneTree

const DIRECTORY := "res://assets/chemistry/sample_tray/"

func _initialize() -> void:
	for asset: String in ["specimens", "vessel_back", "vessel_front"]:
		var image := Image.new()
		var error := image.load_svg_from_string(FileAccess.get_file_as_string(DIRECTORY + asset + ".svg"))
		if error != OK:
			printerr("Cannot normalize " + asset)
			quit(1)
			return
		image.convert(Image.FORMAT_RGBA8)
		error = image.save_png(DIRECTORY + asset + ".png")
		if error != OK:
			quit(1)
			return
		print("%s: %dx%d RGBA8" % [asset, image.get_width(), image.get_height()])
	if not _make_physical_masks():
		quit(1)
		return
	quit(0)


func _make_physical_masks() -> bool:
	var art := Image.load_from_file(DIRECTORY + "specimens.png")
	var masks := Image.create_empty(128, 64, false, Image.FORMAT_RGBA8)
	var seeds: Array[Vector2] = [Vector2(19, 20), Vector2(38, 18), Vector2(46, 31),
		Vector2(30, 33), Vector2(17, 39), Vector2(23, 50), Vector2(43, 48)]
	var pixels: Array = []
	for index: int in range(seeds.size()):
		pixels.append([])
	var bounds := Rect2(64, 64, 0, 0)
	var has_bounds := false
	for y: int in range(64):
		for x: int in range(64):
			if art.get_pixel(128 + x, y).a <= 0.01:
				continue
			var point := Vector2(x + 0.5, y + 0.5)
			var closest := 0
			for index: int in range(1, seeds.size()):
				if point.distance_squared_to(seeds[index]) < point.distance_squared_to(seeds[closest]):
					closest = index
			pixels[closest].append(point)
			masks.set_pixel(x, y, Color(float(closest + 1) / 255.0, 0, 0, 1))
			if not has_bounds:
				bounds = Rect2(x, y, 1, 1)
				has_bounds = true
			else:
				bounds = bounds.expand(Vector2(x, y)).expand(Vector2(x + 1, y + 1))
	var pieces: Array[Dictionary] = []
	for group: Array in pixels:
		if group.is_empty():
			push_error("Every glass region must contain source pixels")
			return false
		var centroid := Vector2.ZERO
		var corners := PackedVector2Array()
		for point: Vector2 in group:
			centroid += point
			for corner: Vector2 in [Vector2(-0.5, -0.5), Vector2(0.5, -0.5), Vector2(0.5, 0.5), Vector2(-0.5, 0.5)]:
				corners.append(point + corner)
		centroid /= float(group.size())
		var hull := Geometry2D.convex_hull(corners)
		var serialized: Array = []
		for point: Vector2 in hull:
			serialized.append([point.x - centroid.x, point.y - centroid.y])
		pieces.append({"centroid": [centroid.x, centroid.y], "pixels": group.size(), "hull": serialized})
	var ice_points: Array[Vector2i] = []
	var outside: Array[Vector2i] = []
	for y: int in range(64):
		for x: int in range(64):
			if art.get_pixel(64 + x, y).a > 0.01:
				ice_points.append(Vector2i(x, y))
			else:
				outside.append(Vector2i(x, y))
	var distances: Array[float] = []
	var maximum := 0.0
	for point: Vector2i in ice_points:
		var distance := 4096.0
		for empty: Vector2i in outside:
			distance = minf(distance, Vector2(point).distance_squared_to(Vector2(empty)))
		var flux := 0.9 + float(point.x) / 64.0 * 0.7 + (1.0 - float(point.y) / 64.0) * 0.25
		var arrival := sqrt(distance) / flux
		arrival *= 0.94 + 0.06 * sin(float(point.x) * 0.21 + float(point.y) * 0.17)
		distances.append(arrival)
		maximum = maxf(maximum, arrival)
	var scores: Array[int] = []
	for index: int in range(ice_points.size()):
		var score := maxi(1, roundi(distances[index] / maximum * 255.0))
		scores.append(score)
		var point := ice_points[index]
		masks.set_pixel(64 + point.x, point.y, Color(float(score) / 255.0, 0, 0, 1))
	var erosion: Array[Dictionary] = []
	for step: int in range(257):
		var count := 0
		var bottom := 0
		for index: int in range(scores.size()):
			if scores[index] > step:
				count += 1
				bottom = maxi(bottom, ice_points[index].y + 1)
		erosion.append({"pixels": count, "bottom": bottom})
	var error := masks.save_png(DIRECTORY + "physical_masks.png")
	if error != OK:
		push_error("Cannot save physical specimen masks: %d" % error)
		return false
	var data := {
		"glass_pieces": pieces, "glass_pixel_count": pixels.reduce(func(total: int, group: Array) -> int: return total + group.size(), 0),
		"glass_bottom": bounds.end.y, "ice_pixel_count": ice_points.size(), "ice_erosion": erosion,
		"model": "Raster glass Voronoi partition; nonuniform inward melt-front arrival mask. Masks drive original artwork, not replacement drawings.",
	}
	var file := FileAccess.open(DIRECTORY + "physical_geometry.json", FileAccess.WRITE)
	if file == null:
		push_error("Cannot save physical geometry")
		return false
	file.store_string(JSON.stringify(data, "\t"))
	file.close()
	file = FileAccess.open(DIRECTORY + "physical_geometry.gd", FileAccess.WRITE)
	if file == null:
		push_error("Cannot save exportable physical geometry")
		return false
	file.store_string("extends RefCounted\n\n# Generated by normalize_assets.gd; do not edit.\nconst DATA := " + JSON.stringify(data, "\t") + "\n")
	print("Physical masks: 7 complementary glass regions; 257 grounded ice melt states")
	return true
