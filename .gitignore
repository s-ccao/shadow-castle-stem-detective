# Godot 4+ specific ignores
.godot/
/android/

# Local source downloads retained for editing reference only. The game uses the
# processed assets in the other asset folders, not these raw files.
/assets/incoming/
/assets/sprites/player/player_move_right.html
/assets/sprites/player/source/

# Godot import metadata for legacy portrait source files that are no longer in
# the project. Current portraits live in portraits_pixel_v2/.
/assets/characters/portraits/

# Byte-compiled output from the Python checks in tools/. Regenerated on every
# run and specific to the local interpreter version.
__pycache__/

# Local Vercel project links contain account-specific identifiers and are
# regenerated by `vercel link` for each deploy target.
.vercel/

# Generated Blender prototype outputs (masks, renders, .blend, captures) and the
# CC0 textures fetched by tools/blender/fetch_textures.py. All are regenerable
# from the committed tools; see docs/AGENT_STAGE_REPORT.md stage UX-20261021-39.
/prototypes/
